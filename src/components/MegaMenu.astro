---
const services = [
  ['Wynajem osuszaczy', '/wynajem-osuszaczy-powietrza-warszawa/', '/menu/osuszacze.jpg'],
  ['Wynajem nagrzewnic', '/wynajem-nagrzewnic-warszawa/', '/menu/nagrzewnice.jpg'],
  ['Wynajem wentylatorów', '/wynajem-wentylatorow-warszawa/', '/menu/wentylatory.jpg'],
  ['Ozonatory', '/wynajem-ozonatorow-powietrza-warszawa/', '/menu/ozonatory.webp'],
  ['Klimatyzatory', '/wynajem-klimatyzatorow-warszawa/', '/menu/klimatyzatory.webp']
];
---

<div class="mega-menu">
  <a class="mega-trigger" href="/#uslugi" aria-haspopup="true">Usługi <span aria-hidden="true">↘</span></a>
  <div class="mega-panel">
    <div class="mega-heading"><span>Wypożyczalnia sprzętu</span><strong>Wybierz usługę dopasowaną do sytuacji.</strong></div>
    <div class="mega-cards">{services.map(([title, href, image]) => <a class="mega-card" href={href}><img src={image} alt="" /><span>{title}</span><i aria-hidden="true">↗</i></a>)}</div>
    <a class="mega-all" href="/#uslugi">Zobacz wszystkie usługi <span>→</span></a>
  </div>
</div>

<style>
  .mega-menu{--mega-width:min(1180px,calc(100vw - 48px));position:relative}.mega-menu:before{position:fixed;z-index:19;top:45px;left:50%;width:var(--mega-width);height:30px;pointer-events:none;transform:translateX(-50%);content:""}.mega-menu:hover:before,.mega-menu:focus-within:before{pointer-events:auto}.mega-trigger{display:flex;align-items:center;gap:6px;color:inherit;text-decoration:none}.mega-trigger span{color:#d9ff42;font-size:.8rem;transition:transform .22s}.mega-panel{position:fixed;z-index:20;top:72px;left:50%;width:var(--mega-width);padding:20px;transform:translate(-50%,-8px);border:1px solid rgba(255,255,255,.12);background:#f6f7f2;color:#071013;box-shadow:0 22px 55px rgba(0,0,0,.32);opacity:0;visibility:hidden;pointer-events:none;transition:opacity .2s,transform .2s,visibility .2s}.mega-menu:hover .mega-panel,.mega-menu:focus-within .mega-panel{opacity:1;visibility:visible;pointer-events:auto;transform:translate(-50%,0)}.mega-menu:hover .mega-trigger span,.mega-menu:focus-within .mega-trigger span{transform:rotate(45deg)}.mega-heading{display:flex;align-items:baseline;justify-content:space-between;gap:20px;margin:2px 0 18px}.mega-heading span{color:#087b6f;font-size:.66rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase}.mega-heading strong{font-size:1.05rem;font-weight:500;letter-spacing:-.03em}.mega-cards{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.mega-card{position:relative;display:block;min-height:180px;overflow:hidden;background:#102328;color:#fff;text-decoration:none}.mega-card:after{position:absolute;inset:0;background:linear-gradient(0deg,rgba(3,11,13,.88),rgba(3,11,13,.05) 74%);content:""}.mega-card img{width:100%;height:180px;object-fit:cover;filter:saturate(.76);transition:transform .35s,filter .35s}.mega-card span,.mega-card i{position:absolute;z-index:1;bottom:15px}.mega-card span{right:32px;left:15px;font-size:.84rem;font-weight:500;line-height:1.2}.mega-card i{right:14px;font-style:normal;color:#d9ff42}.mega-card:hover img{transform:scale(1.07);filter:saturate(1)}.mega-all{display:flex;justify-content:flex-end;gap:9px;margin-top:17px;color:#071013;font-size:.78rem;font-weight:600;text-decoration:none}.mega-all span{color:#087b6f}@media(max-width:850px){.mega-menu:before{display:none}.mega-panel{display:none}.mega-trigger span{display:none}}
</style>
