---
import BaseLayout from '../layouts/BaseLayout.astro';
import MegaMenu from '../components/MegaMenu.astro';

const phone = '+48 505 370 405';
const tel = phone.replaceAll(' ', '');
---

<BaseLayout title="Kontakt | Tani Wynajem" description="Skontaktuj się z Tani Wynajem. Wynajem sprzętu, pomiary wilgotności i lokalizacja wycieków w Warszawie i okolicach.">
  <header class="site-header"><nav class="nav shell" aria-label="Główna nawigacja"><a class="brand" href="/"><i class="mark" aria-hidden="true"></i>tani<span>wynajem</span></a><div class="navlinks"><MegaMenu /><a href="/#jak">Jak działamy</a><a href="/#dlaczego">Dlaczego my</a><a class="active" href="/kontakt/">Kontakt</a></div><a class="phone" href={`tel:${tel}`}>{phone}</a></nav></header>
  <main>
    <section class="hero"><div class="hero-orbit" aria-hidden="true"></div><div class="shell hero-content"><p class="crumb"><a href="/">Start</a><span>/</span>Kontakt</p><div class="eyebrow">Warszawa i okolice · jesteśmy po drugiej stronie</div><h1>Porozmawiajmy o Twojej <em>sytuacji.</em></h1><p class="lead">Opowiedz, czego potrzebujesz — dobierzemy sprzęt, zakres pomiaru albo sposób lokalizacji problemu.</p><a class="button" href={`tel:${tel}`}>Zadzwoń teraz</a></div><div class="hero-note"><strong>Szybka odpowiedź</strong><span>konkretna propozycja</span></div></section>

    <section class="contact-main"><div class="shell contact-grid"><div class="contact-info"><div class="eyebrow dark">dane kontaktowe</div><h2>Najprościej będzie zacząć od telefonu.</h2><p>Jeśli wolisz napisać, wyślij wiadomość z krótkim opisem sytuacji. Wrócimy z odpowiedzią i podpowiemy, jaki będzie najlepszy kolejny krok.</p><div class="details"><div><small>telefon</small><a href={`tel:${tel}`}>{phone}</a></div><div><small>e-mail</small><a href="mailto:kontakt@tani-wynajem.com.pl">kontakt@tani-wynajem.com.pl</a></div><div><small>obszar działania</small><strong>Warszawa i okolice</strong></div></div></div><form class="contact-form" action="mailto:kontakt@tani-wynajem.com.pl" method="post" enctype="text/plain"><div class="eyebrow dark">napisz wiadomość</div><label>Imię i nazwisko<input name="name" type="text" placeholder="Jak mamy się do Ciebie zwracać?" required /></label><label>Telefon lub e-mail<input name="reply" type="text" placeholder="Jak możemy odpowiedzieć?" required /></label><label>Wiadomość<textarea name="message" rows="5" placeholder="Opisz krótko, czego potrzebujesz..." required></textarea></label><button class="button" type="submit">Wyślij wiadomość <span>→</span></button><p class="form-note">Formularz otworzy Twoją aplikację pocztową.</p></form></div></section>

    <section class="prepare"><div class="shell"><div class="eyebrow">żeby pomóc szybciej</div><h2>Co warto podać w wiadomości?</h2><div class="prepare-grid"><div><b>01</b><strong>Rodzaj problemu</strong><p>Zalanie, wilgoć, podejrzenie wycieku, potrzeba osuszania lub wynajmu urządzenia.</p></div><div><b>02</b><strong>Miejsce</strong><p>Adres lub dzielnica, typ pomieszczenia i przybliżony metraż.</p></div><div><b>03</b><strong>Termin</strong><p>Kiedy potrzebujesz pomocy i czy sprawa wymaga szybkiej reakcji.</p></div></div></div></section>

    <section class="contact-strip"><div class="shell strip-box"><div><div class="eyebrow dark">masz pilną sprawę?</div><h2>Zadzwoń — ustalimy, co robić dalej.</h2></div><a class="button dark-button" href={`tel:${tel}`}>{phone}</a></div></section>
  </main>
  <footer class="footer"><div class="shell"><a class="brand" href="/"><i class="mark" aria-hidden="true"></i>tani<span>wynajem</span></a><span>© 2026 Tani Wynajem · Warszawa i okolice</span></div></footer>
</BaseLayout>

<style>
  :global(body){margin:0;background:#061014;color:#f6f7f2;font-family:"Fixel Text",Verdana,sans-serif}.shell{width:min(1180px,calc(100% - 48px));margin:auto}.site-header{position:absolute;z-index:4;left:0;right:0;border-bottom:1px solid rgba(255,255,255,.17)}.nav{height:78px;display:flex;align-items:center;justify-content:space-between;gap:28px}.brand{display:flex;align-items:center;gap:10px;color:#fff;font-size:1.15rem;font-weight:700;letter-spacing:-.045em;text-decoration:none}.mark{position:relative;width:22px;height:22px;background:#d9ff42;clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%)}.mark:after{position:absolute;inset:6px;background:#0a171c;clip-path:inherit;content:""}.navlinks{display:flex;gap:24px;color:#d5ddde;font-size:.76rem}.navlinks a,.phone{color:inherit;text-decoration:none}.navlinks a:hover,.navlinks .active{color:#d9ff42}.phone{color:#d9ff42;font-size:.8rem;white-space:nowrap}.hero{position:relative;min-height:620px;overflow:hidden;background:radial-gradient(circle at 73% 42%,rgba(217,255,66,.2),transparent 14%),linear-gradient(135deg,#0d2731,#061014 72%);isolation:isolate}.hero:before{position:absolute;inset:0;background:linear-gradient(90deg,#061014 0%,rgba(6,16,20,.82) 48%,rgba(6,16,20,.2) 100%);content:"";z-index:-1}.hero-orbit{position:absolute;right:14%;top:22%;width:320px;height:320px;border:1px solid rgba(217,255,66,.3);border-radius:50%}.hero-orbit:before,.hero-orbit:after{position:absolute;border:1px solid rgba(217,255,66,.18);border-radius:50%;content:""}.hero-orbit:before{inset:45px}.hero-orbit:after{inset:95px}.hero-content{position:relative;padding-top:185px}.crumb{display:flex;gap:9px;margin:0 0 48px;color:#c6d1d1;font-size:.78rem}.crumb a{color:#d9ff42;text-decoration:none}.crumb span{opacity:.5}.eyebrow{margin:0 0 12px;color:#d9ff42;font-size:.68rem;font-weight:500;letter-spacing:.06em;text-transform:uppercase}.eyebrow.dark{color:#087b6f}.hero h1{max-width:740px;margin:0;color:#fff;font-size:clamp(3rem,5.3vw,5.5rem);font-weight:500;letter-spacing:-.07em;line-height:.98}.hero h1 em{color:#d9ff42;font-style:normal}.lead{max-width:570px;margin:25px 0 30px;color:#dce5e5;font-size:1.05rem;line-height:1.65}.button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:0 21px;border:1px solid #d9ff42;background:#d9ff42;color:#071013;font-size:.84rem;font-weight:500;text-decoration:none;transition:.2s}.button:hover{transform:translateY(-2px);background:#efffb0}.hero-note{position:absolute;right:max(24px,calc((100% - 1180px)/2));bottom:0;width:215px;padding:22px 24px;background:#d9ff42;color:#071013}.hero-note strong,.hero-note span{display:block}.hero-note strong{font-size:1.35rem;letter-spacing:-.06em}.hero-note span{font-size:.78rem}.contact-main{padding:112px 0;background:#fff;color:#071013}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:95px;align-items:start}.contact-info h2,.prepare h2,.strip-box h2{max-width:600px;margin:0;letter-spacing:-.06em;font-size:clamp(2rem,3vw,3.2rem);font-weight:500;line-height:1.03}.contact-info>p{max-width:520px;color:#526064;line-height:1.7}.details{display:grid;gap:23px;margin-top:42px}.details small{display:block;margin-bottom:5px;color:#087b6f;font-size:.68rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase}.details a,.details strong{color:#071013;font-size:1.15rem;font-weight:600;letter-spacing:-.03em;text-decoration:none}.contact-form{padding:30px;background:#f0f4ef}.contact-form label{display:block;margin-top:20px;color:#526064;font-size:.78rem;font-weight:500}.contact-form input,.contact-form textarea{display:block;box-sizing:border-box;width:100%;margin-top:7px;padding:13px 14px;border:1px solid #cbd7d3;background:#fff;color:#071013;font:inherit;font-size:.85rem;outline:none}.contact-form input:focus,.contact-form textarea:focus{border-color:#087b6f}.contact-form textarea{resize:vertical}.contact-form .button{margin-top:22px}.form-note{margin:13px 0 0;color:#718084;font-size:.72rem}.prepare{padding:105px 0;background:#071014}.prepare h2{margin-bottom:45px}.prepare-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.prepare-grid>div{min-height:190px;padding:24px;border-top:1px solid rgba(217,255,66,.35)}.prepare-grid b{display:block;color:#d9ff42;font-size:.76rem;font-weight:500}.prepare-grid strong{display:block;margin-top:43px;font-size:1.18rem;font-weight:500;letter-spacing:-.04em}.prepare-grid p{max-width:280px;margin:10px 0 0;color:#b7c1c2;font-size:.88rem;line-height:1.6}.contact-strip{padding:95px 0;background:#061014}.strip-box{display:flex;align-items:center;justify-content:space-between;gap:40px;padding:43px;background:#d9ff42;color:#071013}.strip-box h2{margin-top:4px}.dark-button{border-color:#071013;background:#071013;color:#fff}.footer{padding:40px 0;background:#061014;color:#aeb9ba;font-size:.78rem}.footer .shell{display:flex;align-items:center;justify-content:space-between;gap:24px}.footer .brand{font-size:1rem}@media(max-width:850px){.navlinks{display:none}.hero{min-height:600px}.hero-content{padding-top:165px}.hero-orbit{right:-10%}.contact-grid{grid-template-columns:1fr;gap:55px}.strip-box{align-items:start;flex-direction:column}.prepare-grid{grid-template-columns:1fr 1fr}.hero-note{right:24px}}@media(max-width:560px){.shell{width:min(100% - 32px,1180px)}.nav{height:68px}.phone{font-size:.73rem}.hero-content{padding-top:140px}.crumb{margin-bottom:34px}.hero h1{font-size:2.8rem}.lead{font-size:1rem}.hero-note{display:none}.contact-main,.prepare,.contact-strip{padding:72px 0}.prepare-grid{grid-template-columns:1fr}.contact-form{padding:24px}.strip-box{padding:30px}.footer .shell{align-items:start;flex-direction:column}}
</style>
