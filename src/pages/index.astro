---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  ['01 / OSUSZANIE', 'Wynajem osuszaczy', 'Do mieszkań, piwnic, po zalaniu i na budowę.'],
  ['02 / CIEPŁO', 'Wynajem nagrzewnic', 'Do prac remontowych, hal i nieogrzewanych wnętrz.'],
  ['03 / PRZEPŁYW', 'Wynajem wentylatorów', 'Do wspomagania schnięcia i wymiany powietrza.'],
  ['04 / CZYSTE POWIETRZE', 'Ozonatory', 'Do neutralizacji nieprzyjemnych zapachów.'],
  ['05 / CHŁÓD', 'Klimatyzatory', 'Przenośna ulga w upalne dni, bez montażu.'],
  ['06 / DORADZTWO', 'Kompletne zestawy', 'Łączymy urządzenia dla szybszego efektu.']
];
const reasons = [
  ['Sprzęt przygotowany do pracy', 'Każde urządzenie jest sprawdzane przed wydaniem.'],
  ['Pomoc w dobraniu zestawu', 'Dobieramy rozwiązanie do metrażu i problemu, nie „na oko”.'],
  ['Odbiór lub dostawa', 'Wybierasz wariant, który pasuje do Twojego harmonogramu.'],
  ['Przejrzyste rozliczenie', 'Wiesz, za co płacisz — zanim sprzęt trafi na miejsce.']
];
---

<BaseLayout title="Tani Wynajem — sprzęt do osuszania i klimatyzacji" description="Wynajem osuszaczy, nagrzewnic, wentylatorów, ozonatorów i klimatyzatorów. Warszawa i okolice.">
  <header><nav class="wrap nav" aria-label="Główna nawigacja"><a class="brand" href="#start"><i class="mark" aria-hidden="true"></i>tani<span>wynajem</span></a><div class="navlinks"><a href="#uslugi">Usługi</a><a href="#jak">Jak działamy</a><a href="#dlaczego">Dlaczego my</a><a href="#kontakt">Kontakt</a></div><a class="phone" href="tel:+48220000000">+48 22 000 00 00</a></nav></header>
  <main>
    <section class="hero" id="start"><img src="/hero-osuszanie.png" alt="Technik przygotowuje osuszacz przemysłowy w remontowanym wnętrzu"><div class="wrap hero-content"><div class="eyebrow">Warszawa i okolice · sprzęt od ręki</div><h1>Suche mury.<br><span>Spokojna</span> głowa.</h1><p>Wynajmij profesjonalny sprzęt do osuszania, ogrzewania i oczyszczania powietrza. Pomożemy dobrać zestaw do Twojej sytuacji.</p><div class="hero-actions"><a class="button" href="#kontakt">Zapytaj o dostępność</a><a class="button outline" href="#uslugi">Zobacz sprzęt</a></div></div><div class="hero-note"><strong>24 h</strong> szybka dostawa sprzętu na terenie Warszawy</div></section>
    <section class="quick"><div class="wrap quick-grid"><div class="quick-intro"><div class="eyebrow teal">w liczbach</div><h2>Sprzęt, który działa wtedy, gdy liczy się czas.</h2></div><div class="quick-item"><strong>7 dni</strong><span>minimalny okres wynajmu</span></div><div class="quick-item"><strong>24/7</strong><span>odbiór po wcześniejszym ustaleniu</span></div><div class="quick-item"><strong>5 grup</strong><span>specjalistycznego sprzętu</span></div><div class="quick-item"><strong>24 h</strong><span>szybka dostawa na terenie Warszawy</span></div></div></section>
    <section class="intro"><div class="wrap split"><div><div class="eyebrow teal">bez zbędnych formalności</div><h2>Wypożyczalnia sprzętu dla domu, remontu i firmy.</h2><p>Dobieramy urządzenia do zalania, świeżych tynków, chłodnych hal i dusznych mieszkań. Otrzymujesz sprawny sprzęt, jasne zasady oraz pomoc w uruchomieniu.</p><a class="button" href="#jak">Jak to działa</a></div><div class="photo-card" aria-label="Ilustracja osuszacza przemysłowego"><div class="machine"></div><div class="photo-label">Sprawdzony sprzęt. Proste warunki.</div></div></div></section>
    <section class="services" id="uslugi"><div class="wrap"><div class="services-head"><div><div class="eyebrow">co możemy dla Ciebie zrobić</div><h2 class="section-title">Wynajem dopasowany<br>do sytuacji.</h2></div><p>Wybierz kategorię albo zadzwoń. Podpowiemy, które urządzenie będzie właściwe i jak długo powinno pracować.</p></div><div class="services-grid">{services.map(([number, title, copy]) => <a class="service" href="#kontakt"><span class="service-num">{number}</span><div><h3>{title}</h3><p>{copy}</p></div><span class="service-link">{title === 'Kompletne zestawy' ? 'Porozmawiajmy' : 'Sprawdź dostępność'}</span></a>)}</div></div></section>
    <section class="how" id="jak"><div class="wrap how-grid"><div><div class="eyebrow">prosty proces</div><h2 class="section-title">Od telefonu do suchego wnętrza.</h2><p class="muted">Nie musisz znać parametrów urządzeń. Opowiedz nam, co się dzieje.</p></div><div class="steps"><article class="step"><b>01</b><h3>Opisujesz potrzebę</h3><p>Powiedz, co wymaga osuszenia lub schłodzenia i gdzie znajduje się obiekt.</p></article><article class="step"><b>02</b><h3>Dobieramy sprzęt</h3><p>Proponujemy zestaw oraz czas wynajmu — jasno, bez niespodzianek.</p></article><article class="step"><b>03</b><h3>Odbierasz lub zamawiasz dowóz</h3><p>Sprzęt jest gotowy do pracy; podpowiemy, jak go ustawić.</p></article><article class="cta-step"><h3>Potrzebujesz sprzętu dzisiaj?</h3><p>Zapytaj o dostępność przed przyjazdem.</p><a class="button" href="tel:+48220000000">Zadzwoń do nas</a></article></div></div></section>
    <section class="reasons" id="dlaczego"><div class="wrap reason-grid"><div><div class="eyebrow teal">na dobrych warunkach</div><h2 class="section-title">Mniej wilgoci. Mniej stresu. Więcej kontroli.</h2><p>Wynajem ma być wygodnym rozwiązaniem, a nie kolejnym problemem do załatwienia. Dlatego trzymamy się prostych reguł.</p></div><div class="reasons-list">{reasons.map(([title, copy], index) => <div class="reason"><span class="badge">{String(index + 1).padStart(2, '0')}</span><div><strong>{title}</strong><p>{copy}</p></div></div>)}</div></div></section>
    <section class="contact" id="kontakt"><div class="wrap"><div class="contact-box"><div><div class="eyebrow teal">porozmawiajmy</div><h2>Dobierzmy sprzęt do Twojej sprawy.</h2><p>Zadzwoń lub napisz. W wiadomości podaj rodzaj pomieszczenia, przybliżony metraż i termin — wrócimy z konkretną propozycją.</p><a class="button" href="tel:+48220000000">Zadzwoń teraz</a></div><div class="contact-data"><div><small>telefon</small><a href="tel:+48220000000">+48 22 000 00 00</a></div><div><small>e-mail</small><a href="mailto:kontakt@tani-wynajem.pl">kontakt@tani-wynajem.pl</a></div><div><small>obszar działania</small><strong>Warszawa i okolice</strong></div></div></div><footer class="footer"><a class="brand" href="#start"><i class="mark" aria-hidden="true"></i>tani<span>wynajem</span></a><div class="foot-links"><a href="#uslugi">Usługi</a><a href="#jak">Jak działamy</a><a href="#kontakt">Kontakt</a><a href="#start">Polityka prywatności</a></div><span>© 2026 Tani Wynajem</span></footer></div></section>
  </main>

  <style is:global>
    :root{--ink:#061014;--navy:#0b1c24;--lime:#d9ff42;--white:#f6f7f2;--line:rgba(217,255,66,.25)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--ink);color:var(--white);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.45}a{color:inherit;text-decoration:none}.wrap{width:min(1180px,calc(100% - 48px));margin:auto}.eyebrow{color:var(--lime);font-size:.74rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.teal{color:#087b6f}.button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 20px;background:var(--lime);border:1px solid var(--lime);color:#071013;font-size:.86rem;font-weight:800;transition:.2s}.button:hover{background:#efffb0;border-color:#efffb0;transform:translateY(-2px)}.button.outline{background:transparent;color:var(--white);border-color:rgba(255,255,255,.45)}.button.outline:hover{background:#fff;color:#071013}header{position:absolute;z-index:3;left:0;right:0;border-bottom:1px solid rgba(255,255,255,.13)}.nav{height:78px;display:flex;align-items:center;justify-content:space-between;gap:28px}.brand{display:flex;align-items:center;gap:10px;font-weight:900;letter-spacing:-.04em;font-size:1.15rem}.mark{position:relative;width:22px;height:22px;background:var(--lime);clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%)}.mark:after{content:"";position:absolute;inset:6px;background:#0a171c;clip-path:inherit}.navlinks{display:flex;gap:24px;color:#d5ddde;font-size:.8rem;font-weight:700}.navlinks a:hover{color:var(--lime)}.phone{color:var(--lime);font-size:.85rem;font-weight:800;white-space:nowrap}.hero{min-height:690px;display:flex;align-items:flex-end;position:relative;overflow:hidden;background:#091116}.hero:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,10,13,.9),rgba(3,10,13,.71) 40%,rgba(3,10,13,.16) 85%),linear-gradient(0deg,rgba(3,10,13,.75),transparent 40%);z-index:1}.hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}.hero-content{position:relative;z-index:2;padding:175px 0 82px;max-width:690px}.hero h1{font-size:clamp(3rem,7vw,6.5rem);letter-spacing:-.075em;line-height:.88;margin:16px 0 23px;font-weight:850}.hero h1 span{color:var(--lime)}.hero p{max-width:490px;font-size:1.08rem;color:#d2d9d9;margin:0 0 30px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap}.hero-note{position:absolute;right:0;bottom:0;z-index:2;width:230px;padding:18px 21px;background:var(--lime);color:var(--ink);font-size:.78rem;font-weight:800}.hero-note strong{display:block;font-size:1.6rem;letter-spacing:-.06em;line-height:1;margin-bottom:6px}.quick{background:#fff;color:var(--ink);padding:42px 0}.quick-grid{display:grid;grid-template-columns:1.25fr repeat(3,1fr);gap:1px;background:#dce4df}.quick-intro,.quick-item{background:#fff;padding:26px}.quick-intro h2{font-size:1.6rem;letter-spacing:-.055em;line-height:1.03;margin:8px 0 0}.quick-item{min-height:144px;display:flex;flex-direction:column;justify-content:space-between}.quick-item strong{font-size:2.25rem;letter-spacing:-.08em}.quick-item span{font-weight:700;font-size:.85rem}.quick-item:nth-child(3){background:#0d2731;color:#fff}.quick-item:nth-child(4){background:var(--lime)}.intro{background:#fff;color:var(--ink);padding:118px 0;position:relative;overflow:hidden}.intro:after{content:"";position:absolute;width:400px;height:400px;border:1px solid rgba(184,224,39,.45);right:-200px;bottom:-265px;transform:rotate(30deg)}.split{display:grid;grid-template-columns:1.05fr .95fr;gap:80px;align-items:center}.intro h2,.section-title{font-size:clamp(2.2rem,4.4vw,4.2rem);letter-spacing:-.075em;line-height:.94;margin:14px 0 22px}.intro p{max-width:530px;color:#4c5558;font-size:1rem}.photo-card{position:relative;min-height:440px;background:linear-gradient(145deg,#b7d530,#e5ff60);overflow:hidden}.photo-card:after{content:"";position:absolute;inset:28px;border:1px solid rgba(7,16,20,.4)}.photo-card .machine{position:absolute;right:64px;bottom:55px;width:170px;height:250px;border-radius:14px 14px 24px 24px;background:#13242b;box-shadow:25px 28px 0 rgba(3,12,15,.12)}.machine:before{content:"";position:absolute;top:46px;left:24px;right:24px;height:100px;background:repeating-linear-gradient(0deg,#273a41 0 4px,#0b1519 4px 10px)}.machine:after{content:"";position:absolute;left:32px;right:32px;bottom:-28px;height:55px;border-left:12px solid #101619;border-right:12px solid #101619;border-radius:50%}.photo-label{position:absolute;left:32px;bottom:35px;z-index:2;font-size:1.1rem;font-weight:850;max-width:200px;letter-spacing:-.03em}.services{padding:108px 0 118px;background:#071014;position:relative;overflow:hidden}.services:before{content:"";position:absolute;left:-100px;bottom:15px;width:330px;height:330px;border:1px solid var(--line);transform:rotate(30deg)}.services-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:44px}.services-head p{max-width:390px;color:#bac5c7;margin:0}.services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.service{min-height:265px;border:1px solid rgba(255,255,255,.16);padding:24px;display:flex;flex-direction:column;justify-content:space-between;transition:.25s;background:rgba(255,255,255,.015)}.service:hover{background:#102a32;border-color:var(--lime);transform:translateY(-4px)}.service-num{color:var(--lime);font-size:.78rem;font-weight:800}.service h3{font-size:1.45rem;letter-spacing:-.055em;line-height:.95;margin:0}.service p{color:#aab6b8;margin:10px 0 0;font-size:.9rem}.service-link{font-size:.78rem;font-weight:800;color:var(--lime)}.how{background:#0d2731;padding:100px 0}.how-grid{display:grid;grid-template-columns:.9fr 1.7fr;gap:70px}.how .section-title{margin-top:10px}.muted{color:#b9c5c7}.steps{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.step{border-top:1px solid var(--line);padding:20px 0}.step b{display:block;color:var(--lime);font-size:.75rem;margin-bottom:28px}.step h3{font-size:1.12rem;margin:0 0 8px;letter-spacing:-.03em}.step p{color:#b9c5c7;margin:0;font-size:.88rem}.cta-step{background:var(--lime);color:var(--ink);padding:26px}.cta-step h3{font-size:1.35rem;line-height:1;margin:0 0 14px;letter-spacing:-.05em}.cta-step .button{background:var(--ink);border-color:var(--ink);color:#fff}.cta-step .button:hover{background:#fff;color:var(--ink)}.reasons{background:#fff;color:var(--ink);padding:115px 0}.reason-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:70px;align-items:center}.reasons .section-title{max-width:600px}.reasons p{color:#556166;max-width:550px}.reasons-list{display:grid;gap:0}.reason{display:grid;grid-template-columns:46px 1fr;gap:16px;border-top:1px solid #cfd8d4;padding:19px 0}.reason strong{font-size:1rem}.reason p{font-size:.86rem;margin:4px 0 0}.badge{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:var(--lime);font-size:.73rem;font-weight:900}.contact{background:#071014;padding:108px 0 0;position:relative;overflow:hidden}.contact:before{content:"";position:absolute;width:650px;height:650px;border:1px solid rgba(217,255,66,.17);right:-300px;top:-410px;border-radius:50%}.contact-box{background:#d9ff42;color:var(--ink);display:grid;grid-template-columns:1.25fr .75fr;gap:40px;padding:48px;position:relative}.contact h2{font-size:clamp(2.3rem,5vw,5.1rem);letter-spacing:-.075em;line-height:.9;margin:12px 0 18px}.contact p{font-size:1rem;max-width:550px}.contact-data{border-left:1px solid rgba(7,16,20,.28);padding-left:34px;display:grid;align-content:center;gap:20px}.contact-data a{font-size:1.42rem;font-weight:850;letter-spacing:-.05em}.contact-data small{display:block;text-transform:uppercase;letter-spacing:.1em;font-weight:800;font-size:.68rem;margin-bottom:4px}.footer{padding:45px 0 28px;display:flex;justify-content:space-between;align-items:end;gap:30px;color:#aeb9ba;font-size:.77rem}.footer .brand{color:#fff}.foot-links{display:flex;gap:19px;flex-wrap:wrap}.foot-links a:hover{color:var(--lime)}@media(max-width:850px){.navlinks{display:none}.hero{min-height:650px}.hero-note{display:none}.quick-grid{grid-template-columns:repeat(2,1fr)}.quick-intro{grid-column:span 2}.split,.how-grid,.reason-grid,.contact-box{grid-template-columns:1fr;gap:36px}.services-grid{grid-template-columns:repeat(2,1fr)}.contact-data{border-left:0;border-top:1px solid rgba(7,16,20,.28);padding:28px 0 0}.footer{align-items:flex-start;flex-direction:column}}@media(max-width:560px){.wrap{width:min(100% - 32px,1180px)}.nav{height:68px}.phone{font-size:.75rem}.hero-content{padding:150px 0 58px}.hero h1{font-size:3.2rem}.hero p{font-size:1rem}.quick{padding:0}.quick-grid{grid-template-columns:1fr}.quick-intro{grid-column:auto}.intro,.services,.how,.reasons,.contact{padding:72px 0}.photo-card{min-height:330px}.services-head{display:block}.services-head p{margin-top:18px}.services-grid,.steps{grid-template-columns:1fr}.service{min-height:200px}.contact-box{padding:28px}.footer{padding-top:34px}.footer .brand{font-size:1rem}}
    /* Typografia inspirowana referencją RosaPack: Fixel Text, regularne
       akapity oraz wyraźne, lecz nieprzesadnie ciężkie nagłówki. */
    @font-face{font-family:"Fixel Text";font-style:normal;font-weight:400;font-display:swap;src:url("/fonts/FixelText-Regular.woff2") format("woff2")}
    @font-face{font-family:"Fixel Text";font-style:normal;font-weight:500;font-display:swap;src:url("/fonts/FixelText-Medium.woff2") format("woff2")}
    @font-face{font-family:"Fixel Text";font-style:normal;font-weight:600;font-display:swap;src:url("/fonts/FixelText-SemiBold.woff2") format("woff2")}
    @font-face{font-family:"Fixel Text";font-style:normal;font-weight:700;font-display:swap;src:url("/fonts/FixelText-Bold.woff2") format("woff2")}

    body{font-family:"Fixel Text",Verdana,Geneva,Tahoma,sans-serif;font-weight:400;line-height:1.5}
    .eyebrow{font-size:.68rem;font-weight:500;letter-spacing:.04em}
    .brand{font-weight:700;letter-spacing:-.045em}
    .navlinks{font-size:.76rem;font-weight:500}.phone{font-size:.8rem;font-weight:500}
    .button{font-size:.82rem;font-weight:500;letter-spacing:.01em}
    .hero h1{font-size:clamp(2.7rem,3.2vw,4rem);font-weight:500;letter-spacing:-.065em;line-height:.96}
    .hero p{font-size:1rem;line-height:1.6}.hero-note{font-weight:500}.hero-note strong{font-weight:600}
    .quick-intro h2{font-weight:500;letter-spacing:-.045em;line-height:1.08}.quick-item strong{font-weight:500;letter-spacing:-.065em}.quick-item span{font-weight:500}
    .intro h2,.section-title{font-size:clamp(2rem,2.3vw,2.8rem);font-weight:500;letter-spacing:-.06em;line-height:1.02}.intro p,.services-head p,.service p,.step p,.reasons p,.contact p{font-size:.94rem;line-height:1.65}
    .photo-label{font-weight:600}.service-num,.service-link,.step b{font-weight:500}.service h3{font-size:1.25rem;font-weight:500;letter-spacing:-.045em;line-height:1.05}
    .step h3,.cta-step h3,.reason strong{font-weight:600}.contact h2{font-size:clamp(2rem,3vw,3.3rem);font-weight:500;letter-spacing:-.06em;line-height:1}.contact-data a{font-weight:600;letter-spacing:-.035em}.contact-data small{font-weight:500;letter-spacing:.06em}
    @media(max-width:560px){.hero h1{font-size:2.7rem}.eyebrow{font-size:.64rem}}

    /* Hero i sekcja liczb: kompozycja zgodna z układem z referencji. */
    .hero{min-height:960px;align-items:flex-start}
    .hero:before{background:linear-gradient(180deg,rgba(3,11,13,0) 48%,rgba(3,11,13,.3) 66%,#030b0d 100%)}
    .hero-content{max-width:none;padding:300px 0 0}
    .hero .eyebrow,.hero-actions .outline,.hero-note{display:none}
    .hero h1{margin:0;font-size:clamp(3rem,3.37vw,4rem);line-height:1.4}
    .hero p{margin:18px 0 0;font-size:1.125rem;font-weight:500;line-height:1.67}
    .hero-actions{margin-top:20px}.hero .button{background:#fff;border-color:#fff;color:#030b0d}

    .quick{position:relative;min-height:735px;overflow:hidden;background:#000;color:#fff;padding:0}
    .quick:before{position:absolute;bottom:-155px;left:4%;width:370px;height:465px;border:1px solid rgba(217,255,66,.35);clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%);content:"";transform:rotate(30deg)}
    .quick-grid{position:relative;display:grid;grid-template-columns:1fr .5fr .5fr;grid-template-rows:repeat(3,200px);gap:0;background:transparent;padding:55px 0 80px}
    .quick-intro{grid-column:1;grid-row:1 / span 3;align-self:start;max-width:440px;background:transparent;padding:28px 0}
    .quick-intro .eyebrow{display:none}.quick-intro h2{margin:0;color:#fff;font-size:clamp(2.15rem,2.35vw,2.5rem);line-height:1.05}
    .quick-item{position:relative;min-height:0;padding:30px 25px 20px;background:#0e2226;color:#fff}
    .quick-item strong{font-size:2rem;line-height:1;font-weight:600}.quick-item span{font-size:.9rem;font-weight:500;line-height:1.35}
    .quick-item:nth-child(2){grid-column:2;grid-row:1;background:#fff;color:#071013}.quick-item:nth-child(3){grid-column:2;grid-row:2;background:#0e2226}.quick-item:nth-child(4){grid-column:3;grid-row:2;background:#fff;color:#071013}.quick-item:nth-child(5){grid-column:3;grid-row:3;background:#0e2226}
    .quick-item:after{position:absolute;right:25px;top:28px;width:24px;height:24px;border:2px solid currentColor;border-radius:4px;content:"";opacity:.65}

    @media(max-width:850px){.hero{min-height:700px}.hero-content{padding:190px 0 0}.quick{min-height:0}.quick-grid{grid-template-columns:repeat(2,1fr);grid-template-rows:auto;padding:0}.quick-intro{grid-column:span 2;grid-row:auto;max-width:none;padding:54px 0 30px}.quick-item,.quick-item:nth-child(n){grid-column:auto;grid-row:auto;min-height:180px}.quick-item:nth-child(2){grid-column:1}.quick-item:nth-child(3){grid-column:2}.quick-item:nth-child(4){grid-column:1}.quick-item:nth-child(5){grid-column:2}}
    @media(max-width:560px){.hero{min-height:650px}.hero-content{padding:158px 0 0}.hero h1{font-size:2.7rem;line-height:1.08}.hero p{font-size:1rem}.quick-grid{grid-template-columns:1fr}.quick-intro{grid-column:1;padding:52px 0 28px}.quick-item,.quick-item:nth-child(n){grid-column:1;min-height:155px}.quick-intro h2{font-size:2rem}}
  </style>
</BaseLayout>
