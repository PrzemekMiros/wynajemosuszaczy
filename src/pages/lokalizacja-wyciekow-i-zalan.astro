---
import BaseLayout from '../layouts/BaseLayout.astro';
import MegaMenu from '../components/MegaMenu.astro';

const phone = '+48 505 370 405';
const tel = phone.replaceAll(' ', '');
const methods = [
  ['01', 'Próby ciśnieniowe', 'Sprawdzamy szczelność instalacji wodnych i zawężamy obszar poszukiwań.'],
  ['02', 'Termowizja i pomiary', 'Obserwujemy rozkład temperatur i wilgotności, aby znaleźć ślady niewidoczne gołym okiem.'],
  ['03', 'Gaz znacznikowy', 'W razie potrzeby stosujemy metodę pozwalającą wskazać nawet małą nieszczelność instalacji.'],
  ['04', 'Kanalizacja i grunt', 'Możemy sprawdzić instalacje kanalizacyjne oraz wycieki poza budynkiem.']
];
---

<BaseLayout title="Lokalizacja wycieków i zalań | Tani Wynajem" description="Lokalizacja wycieków wody i zalań w Warszawie i okolicach. Próby ciśnieniowe, termowizja, gaz znacznikowy i pomiary wilgotności." image="/hero-lokalizacja-wyciekow.png">
  <header class="site-header"><nav class="nav shell" aria-label="Główna nawigacja"><a class="brand" href="/"><i class="mark" aria-hidden="true"></i>tani<span>wynajem</span></a><div class="navlinks"><MegaMenu /><a href="/#jak">Jak działamy</a><a href="/#dlaczego">Dlaczego my</a><a href="/kontakt/">Kontakt</a></div><a class="phone" href={`tel:${tel}`}>{phone}</a></nav></header>
  <main>
    <section class="hero"><div class="signal signal-one" aria-hidden="true"></div><div class="signal signal-two" aria-hidden="true"></div><div class="shell hero-content"><p class="crumb"><a href="/">Start</a><span>/</span>Lokalizacja wycieków i zalań</p><div class="eyebrow">Warszawa i okolice · precyzyjna diagnostyka</div><h1>Znajdziemy źródło <em>wycieku.</em></h1><p class="lead">Pomagamy ustalić, skąd bierze się wilgoć — w mieszkaniu, domu, lokalu użytkowym, instalacji, podłodze lub na zewnątrz budynku.</p><div class="actions"><a class="button" href={`tel:${tel}`}>Zgłoś problem</a><a class="button outline" href="#metody">Poznaj metody</a></div></div><div class="hero-note"><strong>Bez zgadywania</strong><span>i niepotrzebnego kucia</span></div></section>
    <section class="intro"><div class="shell intro-grid"><div><div class="eyebrow dark">szybka diagnoza</div><h2>Mały ślad wilgoci może oznaczać duży problem.</h2><p>Ukryty wyciek potrafi uszkadzać ściany, podłogi i izolację, a także powodować rozwój pleśni. Najpierw oglądamy miejsce zgłoszenia i zbieramy objawy, a następnie dobieramy metodę do rodzaju instalacji i konstrukcji budynku.</p><a class="text-link" href={`tel:${tel}`}>Porozmawiaj z technikiem <span>→</span></a></div><div class="scan-card"><div class="scan-grid"></div><div class="scan-dot"></div><span>obszar podejrzenia<br /><b>lokalizacja punktowa</b></span></div></div></section>
    <section class="methods" id="metody"><div class="shell"><div class="section-heading"><div><div class="eyebrow">dobieramy technologię</div><h2>Jak możemy szukać wycieku?</h2></div><p>Nie każda nieszczelność daje taki sam sygnał. Łączymy metody, kiedy wymaga tego sytuacja.</p></div><div class="method-grid">{methods.map(([number, title, text]) => <article><span>{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
    <section class="cases"><div class="shell"><div class="eyebrow dark">typowe zgłoszenia</div><h2>W czym pomagamy?</h2><div class="case-grid"><div><strong>Wyciek w mieszkaniu</strong><p>Plamy na ścianie, mokre fugi, odchodząca farba albo wilgoć u sąsiada poniżej.</p></div><div><strong>Zalanie pod posadzką</strong><p>Sprawdzamy, czy woda dostała się pod podłogę i jaki jest zasięg zawilgocenia.</p></div><div><strong>Instalacja wodna</strong><p>Pomagamy zawęzić miejsce nieszczelności w instalacji centralnego ogrzewania lub wody użytkowej.</p></div><div><strong>Wyciek na zewnątrz</strong><p>Możemy zająć się także wyciekiem w gruncie, na dachu, balkonie lub przy kanalizacji.</p></div></div></div></section>
    <section class="process"><div class="shell"><div class="eyebrow">jasny przebieg</div><h2>Od objawu do konkretnego miejsca.</h2><div class="steps"><article><b>01</b><h3>Rozpoznanie</h3><p>Opowiadasz, co się dzieje i od kiedy widzisz problem.</p></article><article><b>02</b><h3>Badanie</h3><p>Wykonujemy oględziny i dobieramy najmniej inwazyjną metodę.</p></article><article><b>03</b><h3>Wynik</h3><p>Wskazujemy obszar wycieku i rekomendujemy dalsze działania lub osuszanie.</p></article></div></div></section>
    <section class="contact" id="kontakt"><div class="shell contact-box"><div><div class="eyebrow dark">potrzebujesz pomocy?</div><h2>Nie czekaj, aż wilgoć się rozprzestrzeni.</h2><p>Zadzwoń lub napisz, gdzie pojawił się problem. Wstępnie ocenimy sytuację i ustalimy kolejny krok.</p></div><div class="contact-actions"><a class="button dark-button" href={`tel:${tel}`}>Zadzwoń: {phone}</a><a href="mailto:kontakt@tani-wynajem.com.pl">kontakt@tani-wynajem.com.pl</a></div></div></section>
  </main><footer class="footer"><div class="shell"><a class="brand" href="/"><i class="mark" aria-hidden="true"></i>tani<span>wynajem</span></a><span>© 2026 Tani Wynajem · Warszawa i okolice</span></div></footer>
</BaseLayout>

<style>
  :global(body){margin:0;background:#061014;color:#f6f7f2;font-family:"Fixel Text",Verdana,sans-serif}.shell{width:min(1180px,calc(100% - 48px));margin:auto}.site-header{position:absolute;z-index:4;left:0;right:0;border-bottom:1px solid rgba(255,255,255,.17)}.nav{height:78px;display:flex;align-items:center;justify-content:space-between;gap:28px}.brand{display:flex;align-items:center;gap:10px;color:#fff;font-size:1.15rem;font-weight:700;letter-spacing:-.045em;text-decoration:none}.mark{position:relative;width:22px;height:22px;background:#d9ff42;clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%)}.mark:after{position:absolute;inset:6px;background:#0a171c;clip-path:inherit;content:""}.navlinks{display:flex;gap:24px;color:#d5ddde;font-size:.76rem}.navlinks a,.phone{color:inherit;text-decoration:none}.navlinks a:hover{color:#d9ff42}.phone{color:#d9ff42;font-size:.8rem;white-space:nowrap}.hero{position:relative;min-height:690px;overflow:hidden;background:radial-gradient(circle at 72% 48%,rgba(217,255,66,.2),transparent 15%),linear-gradient(135deg,#0d2731,#061014 70%);isolation:isolate}.hero:before{position:absolute;inset:0;background:linear-gradient(90deg,#061014 0%,rgba(6,16,20,.86) 42%,rgba(6,16,20,.2) 100%);content:"";z-index:-1}.signal{position:absolute;border:1px solid rgba(217,255,66,.3);border-radius:50%;right:13%;top:28%;width:260px;height:260px}.signal:before,.signal:after{position:absolute;border:1px solid rgba(217,255,66,.18);border-radius:50%;content:""}.signal:before{inset:35px}.signal:after{inset:75px}.signal-two{width:12px;height:12px;right:29%;top:48%;background:#d9ff42;border:0}.signal-two:before,.signal-two:after{inset:-18px;border-color:rgba(217,255,66,.3)}.signal-two:after{inset:-38px}.hero-content{position:relative;padding-top:185px}.crumb{display:flex;gap:9px;margin:0 0 54px;color:#c6d1d1;font-size:.78rem}.crumb a{color:#d9ff42;text-decoration:none}.crumb span{opacity:.5}.eyebrow{margin:0 0 12px;color:#d9ff42;font-size:.68rem;font-weight:500;letter-spacing:.06em;text-transform:uppercase}.eyebrow.dark{color:#087b6f}.hero h1{max-width:700px;margin:0;color:#fff;font-size:clamp(3rem,5.4vw,5.7rem);font-weight:500;letter-spacing:-.07em;line-height:.98}.hero h1 em{color:#d9ff42;font-style:normal}.lead{max-width:570px;margin:25px 0 0;color:#dce5e5;font-size:1.05rem;line-height:1.65}.actions{display:flex;gap:12px;margin-top:30px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 21px;border:1px solid #d9ff42;background:#d9ff42;color:#071013;font-size:.84rem;font-weight:500;text-decoration:none;transition:.2s}.button:hover{transform:translateY(-2px);background:#efffb0}.button.outline{border-color:rgba(255,255,255,.55);background:transparent;color:#fff}.button.outline:hover{background:#fff;color:#071013}.hero-note{position:absolute;right:max(24px,calc((100% - 1180px)/2));bottom:0;width:215px;padding:22px 24px;background:#d9ff42;color:#071013}.hero-note strong,.hero-note span{display:block}.hero-note strong{font-size:1.45rem;letter-spacing:-.06em}.hero-note span{font-size:.78rem}.intro,.cases{padding:112px 0;background:#fff;color:#071013}.intro-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:95px;align-items:center}.intro h2,.methods h2,.cases h2,.process h2,.contact h2{max-width:700px;margin:0;letter-spacing:-.06em;font-size:clamp(2rem,3vw,3.2rem);font-weight:500;line-height:1.03}.intro p{max-width:570px;color:#526064;line-height:1.7}.text-link{display:inline-flex;gap:10px;margin-top:18px;color:#071013;font-size:.9rem;font-weight:600;text-decoration:none}.text-link span{color:#087b6f}.scan-card{position:relative;min-height:315px;overflow:hidden;background:#0d2731}.scan-grid{position:absolute;inset:0;background:linear-gradient(rgba(217,255,66,.13) 1px,transparent 1px),linear-gradient(90deg,rgba(217,255,66,.13) 1px,transparent 1px);background-size:42px 42px;transform:perspective(260px) rotateX(48deg) scale(1.4);transform-origin:center bottom}.scan-dot{position:absolute;left:55%;top:43%;width:14px;height:14px;border:4px solid #d9ff42;border-radius:50%;box-shadow:0 0 0 18px rgba(217,255,66,.15),0 0 0 42px rgba(217,255,66,.08)}.scan-card>span{position:absolute;left:26px;bottom:24px;color:#dce5e5;font-size:.83rem;line-height:1.45}.scan-card b{color:#d9ff42;font-weight:500}.methods{padding:110px 0;background:#071014}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:45px}.section-heading p{max-width:395px;margin:0;color:#b7c1c2;line-height:1.65}.method-grid,.case-grid,.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.method-grid article{min-height:220px;padding:24px;border:1px solid rgba(255,255,255,.18)}.method-grid span,.steps b{color:#d9ff42;font-size:.76rem}.method-grid h3{margin:50px 0 10px;font-size:1.25rem;font-weight:500;letter-spacing:-.045em}.method-grid p,.steps p{margin:0;color:#b7c1c2;font-size:.9rem;line-height:1.6}.cases h2{margin-top:4px}.case-grid{margin-top:50px}.case-grid>div{padding:25px 0;border-top:1px solid #cbd7d3}.case-grid strong{font-size:1.05rem;font-weight:600}.case-grid p{margin:10px 0 0;color:#526064;font-size:.9rem;line-height:1.6}.process{padding:105px 0;background:#0d2731}.process h2{margin-bottom:45px}.steps article{padding:20px 0;border-top:1px solid rgba(217,255,66,.35)}.steps{grid-template-columns:repeat(3,1fr)}.steps h3{margin:30px 0 8px;font-size:1.2rem;font-weight:500}.contact{padding:95px 0;background:#071014}.contact-box{display:flex;align-items:center;justify-content:space-between;gap:48px;padding:48px;background:#d9ff42;color:#071013}.contact h2{margin-top:4px}.contact p{max-width:580px;margin:15px 0 0;color:#263228;line-height:1.6}.contact-actions{display:flex;flex-direction:column;align-items:flex-start;gap:13px;min-width:260px}.dark-button{border-color:#071013;background:#071013;color:#fff}.contact-actions>a:last-child{color:#071013;font-size:.84rem;font-weight:600}.footer{padding:40px 0;background:#071014;color:#aeb9ba;font-size:.78rem}.footer .shell{display:flex;align-items:center;justify-content:space-between;gap:24px}.footer .brand{font-size:1rem}@media(max-width:850px){.navlinks{display:none}.hero{min-height:650px}.hero-content{padding-top:165px}.signal{right:-10%}.intro-grid{grid-template-columns:1fr;gap:45px}.section-heading{align-items:start;flex-direction:column}.contact-box{align-items:start;flex-direction:column}.hero-note{right:24px}.method-grid,.case-grid{grid-template-columns:1fr 1fr}}@media(max-width:560px){.shell{width:min(100% - 32px,1180px)}.nav{height:68px}.phone{font-size:.73rem}.hero-content{padding-top:140px}.crumb{margin-bottom:35px}.hero h1{font-size:2.8rem}.lead{font-size:1rem}.actions{flex-direction:column;align-items:start}.hero-note{display:none}.intro,.methods,.cases,.process,.contact{padding:72px 0}.method-grid,.case-grid,.steps{grid-template-columns:1fr}.scan-card{min-height:280px}.contact-box{padding:30px}.footer .shell{align-items:start;flex-direction:column}}
</style>

<style>
  .hero{background-image:linear-gradient(90deg,rgba(6,16,20,.96) 0%,rgba(6,16,20,.8) 42%,rgba(6,16,20,.25) 100%),url('/hero-lokalizacja-wyciekow.png');background-position:center;background-size:cover}
</style>
