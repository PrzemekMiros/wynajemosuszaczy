---
import BaseLayout from '../layouts/BaseLayout.astro';
import MegaMenu from '../components/MegaMenu.astro';

const phone = '+48 505 370 405';
const tel = phone.replaceAll(' ', '');
const services = [
  ['01', 'Wilgotność powietrza', 'Sprawdzamy wilgotność względną pomieszczenia. Wynik pomaga ocenić skalę zalania i dobrać dalsze działania.'],
  ['02', 'Materiały budowlane', 'Badamy ściany, tynki, beton, drewno i inne przegrody, uwzględniając ich rodzaj oraz sposób pomiaru.'],
  ['03', 'Warstwy posadzkowe', 'Weryfikujemy zawilgocenie podłogi — także bezinwazyjnie, w dostępnej dylatacji lub otworze technologicznym.'],
  ['04', 'Raport i dokumentacja', 'Pomiary początkowe, kontrolne i końcowe porządkują proces osuszania i mogą wesprzeć rozliczenie szkody.']
];
---

<BaseLayout title="Pomiary wilgotności i ekspertyzy | Tani Wynajem" description="Pomiary wilgotności, badanie zawilgocenia przegród i praktyczne ekspertyzy dla mieszkań, domów i firm w Warszawie i okolicach.">
  <header class="site-header"><nav class="nav shell" aria-label="Główna nawigacja"><a class="brand" href="/"><i class="mark" aria-hidden="true"></i>tani<span>wynajem</span></a><div class="navlinks"><MegaMenu /><a href="/#jak">Jak działamy</a><a href="/#dlaczego">Dlaczego my</a><a href="/kontakt/">Kontakt</a></div><a class="phone" href={`tel:${tel}`}>{phone}</a></nav></header>
  <main>
    <section class="hero"><img class="hero-image" src="/hero-pomiary-wilgotnosci.png" alt="Pomiar wilgotności ściany profesjonalnym miernikiem" /><div class="hero-pattern" aria-hidden="true"><span></span><span></span><span></span></div><div class="shell hero-content"><p class="crumb"><a href="/">Start</a><span>/</span>Pomiary i ekspertyzy</p><div class="eyebrow">Warszawa i okolice · konkretny pomiar, jasne zalecenia</div><h1>Pomiary wilgotności <em>i ekspertyzy</em></h1><p class="lead">Sprawdzimy, skąd bierze się wilgoć i co zrobić, żeby problem nie wracał. Rzetelne pomiary dla domu, mieszkania, biura i budowy.</p><div class="actions"><a class="button" href={`tel:${tel}`}>Umów pomiar</a><a class="button outline" href="#zakres">Zobacz zakres usługi</a></div></div><div class="hero-note"><strong>Pomiar</strong><span>zamiast zgadywania</span></div></section>
    <section class="intro" id="zakres"><div class="shell intro-grid"><div><div class="eyebrow dark">wiarygodna diagnoza</div><h2>Najpierw mierzymy. Potem dobieramy rozwiązanie.</h2><p>Wilgotna ściana, zapach stęchlizny albo odpadająca farba mogą mieć różne przyczyny. Łączymy pomiar z oględzinami, żeby wskazać najbardziej prawdopodobne źródło problemu i następne kroki. Prawidłowy poziom wilgotności zależy od materiału, temperatury i przeznaczenia pomieszczenia — dlatego sam odczyt procentowy nie zastępuje interpretacji.</p></div><div class="measurement-card"><div class="meter"><i></i><b>68</b><small>% RH</small></div><span>czytelny wynik<br />i praktyczny komentarz</span></div></div></section>
    <section class="services"><div class="shell"><div class="section-heading"><div><div class="eyebrow">zakres usługi</div><h2>Co sprawdzamy na miejscu?</h2></div><p>Zakres dopasowujemy do sytuacji. Przed przyjazdem zapytamy o objawy, historię zalania i rodzaj budynku.</p></div><div class="service-grid">{services.map(([number, title, text]) => <article><span>{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
    <section class="for-whom"><div class="shell"><div class="eyebrow dark">kiedy warto</div><h2>Ekspertyza pomaga podjąć dobrą decyzję.</h2><div class="cases"><div><strong>Po zalaniu</strong><p>Żeby ocenić, czy przegrody i podłogi są już wystarczająco suche przed remontem.</p></div><div><strong>Przed zakupem</strong><p>Żeby sprawdzić, czy widoczne ślady nie oznaczają większego problemu.</p></div><div><strong>Przed pracami wykończeniowymi</strong><p>Żeby nie zamknąć wilgoci pod tynkiem, farbą, drewnem lub posadzką.</p></div><div><strong>Przy reklamacjach</strong><p>Żeby zebrać konkretne wyniki i uporządkować rozmowę z wykonawcą lub ubezpieczycielem.</p></div></div></div></section>
    <section class="process"><div class="shell"><div class="eyebrow">prosty przebieg</div><h2>Od zgłoszenia do rekomendacji.</h2><div class="steps"><article><b>01</b><h3>Rozmowa</h3><p>Opisujesz objawy, historię zalania i lokalizację. Ustalamy dogodny termin.</p></article><article><b>02</b><h3>Pomiary i oględziny</h3><p>Sprawdzamy powietrze, przegrody lub warstwy podłogi i porównujemy wyniki.</p></article><article><b>03</b><h3>Wnioski i dokumentacja</h3><p>Otrzymujesz podsumowanie, zalecenia oraz — jeśli potrzeba — wyniki do dokumentacji szkody.</p></article></div></div></section>
    <section class="contact" id="kontakt"><div class="shell contact-box"><div><div class="eyebrow dark">porozmawiajmy</div><h2>Masz podejrzenie zawilgocenia?</h2><p>Zadzwoń lub napisz, co dzieje się w pomieszczeniu. Podpowiemy, jaki zakres pomiaru będzie najbardziej sensowny.</p></div><div class="contact-actions"><a class="button dark-button" href={`tel:${tel}`}>Zadzwoń: {phone}</a><a href="mailto:kontakt@tani-wynajem.com.pl">kontakt@tani-wynajem.com.pl</a></div></div></section>
  </main><footer class="footer"><div class="shell"><a class="brand" href="/"><i class="mark" aria-hidden="true"></i>tani<span>wynajem</span></a><span>© 2026 Tani Wynajem · Warszawa i okolice</span></div></footer>
</BaseLayout>

<style>
  :global(body){margin:0;background:#061014;color:#f6f7f2;font-family:"Fixel Text",Verdana,sans-serif}.shell{width:min(1180px,calc(100% - 48px));margin:auto}.site-header{position:absolute;z-index:4;left:0;right:0;border-bottom:1px solid rgba(255,255,255,.17)}.nav{height:78px;display:flex;align-items:center;justify-content:space-between;gap:28px}.brand{display:flex;align-items:center;gap:10px;color:#fff;font-size:1.15rem;font-weight:700;letter-spacing:-.045em;text-decoration:none}.mark{position:relative;width:22px;height:22px;background:#d9ff42;clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%)}.mark:after{position:absolute;inset:6px;background:#0a171c;clip-path:inherit;content:""}.navlinks{display:flex;gap:24px;color:#d5ddde;font-size:.76rem}.navlinks a,.phone{color:inherit;text-decoration:none}.navlinks a:hover{color:#d9ff42}.phone{color:#d9ff42;font-size:.8rem;white-space:nowrap}.hero{position:relative;min-height:690px;overflow:hidden;background:#091116;isolation:isolate}.hero:before{position:absolute;inset:0;background:linear-gradient(90deg,#061014 0%,rgba(6,16,20,.87) 40%,rgba(6,16,20,.35) 100%);content:"";z-index:-1}.hero-pattern{position:absolute;z-index:-2;inset:0;background:radial-gradient(circle at 73% 45%,rgba(217,255,66,.18),transparent 14%),linear-gradient(135deg,#0d2731,#061014 72%)}.hero-pattern span{position:absolute;width:310px;height:310px;border:1px solid rgba(217,255,66,.25);border-radius:50%;right:13%;top:22%}.hero-pattern span:nth-child(2){width:205px;height:205px;right:19%;top:31%;border-color:rgba(255,255,255,.22)}.hero-pattern span:nth-child(3){width:14px;height:14px;right:29%;top:52%;background:#d9ff42;border:0}.hero-content{position:relative;padding-top:185px}.crumb{display:flex;gap:9px;margin:0 0 54px;color:#c6d1d1;font-size:.78rem}.crumb a{color:#d9ff42;text-decoration:none}.crumb span{opacity:.5}.eyebrow{margin:0 0 12px;color:#d9ff42;font-size:.68rem;font-weight:500;letter-spacing:.06em;text-transform:uppercase}.eyebrow.dark{color:#087b6f}.hero h1{max-width:700px;margin:0;color:#fff;font-size:clamp(3rem,5.3vw,5.6rem);font-weight:500;letter-spacing:-.07em;line-height:.98}.hero h1 em{color:#d9ff42;font-style:normal}.lead{max-width:570px;margin:25px 0 0;color:#dce5e5;font-size:1.05rem;line-height:1.65}.actions{display:flex;gap:12px;margin-top:30px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 21px;border:1px solid #d9ff42;background:#d9ff42;color:#071013;font-size:.84rem;font-weight:500;text-decoration:none;transition:.2s}.button:hover{transform:translateY(-2px);background:#efffb0}.button.outline{border-color:rgba(255,255,255,.55);background:transparent;color:#fff}.button.outline:hover{background:#fff;color:#071013}.hero-note{position:absolute;right:max(24px,calc((100% - 1180px)/2));bottom:0;width:215px;padding:22px 24px;background:#d9ff42;color:#071013}.hero-note strong,.hero-note span{display:block}.hero-note strong{font-size:1.7rem;letter-spacing:-.06em}.hero-note span{font-size:.78rem}.intro,.for-whom{padding:112px 0;background:#fff;color:#071013}.intro-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:95px;align-items:center}.intro h2,.services h2,.for-whom h2,.process h2,.contact h2{max-width:690px;margin:0;letter-spacing:-.06em;font-size:clamp(2rem,3vw,3.2rem);font-weight:500;line-height:1.03}.intro p{max-width:560px;color:#526064;line-height:1.7}.measurement-card{position:relative;min-height:315px;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;background:linear-gradient(145deg,#d9ff42,#a8c925)}.measurement-card:before{position:absolute;width:260px;height:260px;border:1px solid rgba(7,16,20,.3);border-radius:50%;content:""}.meter{position:relative;display:flex;align-items:baseline;gap:5px;color:#071013}.meter i{position:absolute;left:-21px;bottom:5px;width:8px;height:8px;border-radius:50%;background:#087b6f}.meter b{font-size:5rem;font-weight:500;letter-spacing:-.11em}.meter small{font-size:1rem}.measurement-card>span{font-size:.83rem;line-height:1.45;text-align:center}.services{padding:110px 0;background:#071014}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:45px}.section-heading p{max-width:395px;margin:0;color:#b7c1c2;line-height:1.65}.service-grid,.cases,.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.service-grid article{min-height:220px;padding:24px;border:1px solid rgba(255,255,255,.18)}.service-grid span,.steps b{color:#d9ff42;font-size:.76rem}.service-grid h3{margin:50px 0 10px;font-size:1.35rem;font-weight:500;letter-spacing:-.045em}.service-grid p,.steps p{margin:0;color:#b7c1c2;font-size:.9rem;line-height:1.6}.for-whom h2{margin-top:5px}.cases{margin-top:50px}.cases>div{padding:25px 0;border-top:1px solid #cbd7d3}.cases strong{font-size:1.1rem;font-weight:600}.cases p{margin:10px 0 0;color:#526064;font-size:.9rem;line-height:1.6}.process{padding:105px 0;background:#0d2731}.process h2{margin-bottom:45px}.steps article{padding:20px 0;border-top:1px solid rgba(217,255,66,.35)}.steps h3{margin:30px 0 8px;font-size:1.2rem;font-weight:500}.contact{padding:95px 0;background:#071014}.contact-box{display:flex;align-items:center;justify-content:space-between;gap:48px;padding:48px;background:#d9ff42;color:#071013}.contact h2{margin-top:4px}.contact p{max-width:580px;margin:15px 0 0;color:#263228;line-height:1.6}.contact-actions{display:flex;flex-direction:column;align-items:flex-start;gap:13px;min-width:260px}.dark-button{border-color:#071013;background:#071013;color:#fff}.contact-actions>a:last-child{color:#071013;font-size:.84rem;font-weight:600}.footer{padding:40px 0;background:#071014;color:#aeb9ba;font-size:.78rem}.footer .shell{display:flex;align-items:center;justify-content:space-between;gap:24px}.footer .brand{font-size:1rem}@media(max-width:850px){.navlinks{display:none}.hero{min-height:650px}.hero-content{padding-top:165px}.hero-pattern span{right:-10%}.intro-grid{grid-template-columns:1fr;gap:45px}.section-heading{align-items:start;flex-direction:column}.contact-box{align-items:start;flex-direction:column}.hero-note{right:24px}.service-grid,.cases,.steps{grid-template-columns:1fr 1fr}}@media(max-width:560px){.shell{width:min(100% - 32px,1180px)}.nav{height:68px}.phone{font-size:.73rem}.hero-content{padding-top:140px}.crumb{margin-bottom:35px}.hero h1{font-size:2.8rem}.lead{font-size:1rem}.actions{flex-direction:column;align-items:start}.hero-note{display:none}.intro,.services,.for-whom,.process,.contact{padding:72px 0}.service-grid,.cases,.steps{grid-template-columns:1fr}.measurement-card{min-height:280px}.contact-box{padding:30px}.footer .shell{align-items:start;flex-direction:column}}
</style>

<style>
  .hero-image{position:absolute;z-index:0;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}
  .hero:before{z-index:1;background:linear-gradient(90deg,#061014 0%,rgba(6,16,20,.87) 40%,rgba(6,16,20,.35) 100%),linear-gradient(0deg,rgba(6,16,20,.5),transparent 55%)}
  .hero-pattern{z-index:2;background:radial-gradient(circle at 73% 45%,rgba(217,255,66,.12),transparent 14%),linear-gradient(135deg,rgba(13,39,49,.35),rgba(6,16,20,.18) 72%)}
  .hero-content,.hero-note{z-index:3}
  .hero-content{position:relative}.hero-note{position:absolute}
</style>
